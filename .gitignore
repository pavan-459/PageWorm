# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Build outputs (EAS / local builds)
*.apk
*.aab
*.ipa
builds/

# Secrets: never commit store credentials or env files
.env
.env*.local
*service-account*.json
google-play-*.json
credentials.json

# Personal Claude Code settings (shared .claude/settings.json is fine to commit)
.claude/settings.local.json
